# i3 config (linux only). Modelled on config/aerospace/aerospace.toml.
# Pick the "i3" session on the login screen; Cinnamon stays available.
# Reload with $mod+shift+semicolon then Esc, or $mod+shift+r to restart i3.
#
# Modifier: aerospace uses option (alt), but alt is ghostty's cmd stand-in on
# linux. Super sits where option does on a mac keyboard, so it's Mod4 here.
set $mod Mod4

font pango:monospace 10
floating_modifier $mod
focus_follows_mouse no
# like aerospace's 'move-mouse monitor-lazy-center' on monitor change
mouse_warping output

# aerospace gaps are all 0; thin borders so the focused window is visible
gaps inner 0
gaps outer 0
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# aerospace 'default-root-container-orientation = auto'
default_orientation auto
workspace_layout default

set $launch ~/.config/i3/focus-or-launch.sh

# --- Startup ----------------------------------------------------------------
# Cinnamon isn't running in this session, so start what it normally provides.
exec --no-startup-id dex --autostart --environment i3 2>/dev/null
exec --no-startup-id nm-applet
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork --color=000000
exec_always --no-startup-id feh --no-fehbg --bg-fill --randomize --recursive ~/Documents/desktop-backgrounds

# --- Window -> workspace rules (aerospace on-window-detected) ----------------
assign [class="(?i)firefox"]                workspace F
assign [class="(?i)google-chrome"]          workspace c
assign [class="(?i)slack"]                  workspace s
assign [class="(?i)discord"]                workspace D
assign [class="(?i)bruno"]                  workspace B
assign [class="(?i)mongodb compass"]        workspace m
assign [class="(?i)studio 3t"]              workspace m
assign [class="(?i)zoom"]                   workspace z
assign [class="(?i)com.mitchellh.ghostty"]  workspace t
# IDEs
assign [class="(?i)goland"]                 workspace g
assign [class="(?i)pycharm"]                workspace p
assign [class="(?i)intellij|idea"]          workspace i
assign [class="(?i)cursor"]                 workspace w
# spotify sets its class after mapping, so assign doesn't catch it
for_window [class="(?i)spotify"] move to workspace S

# textedit / finder equivalents float
for_window [class="(?i)xed"]  floating enable
for_window [class="(?i)nemo"] floating enable
for_window [window_role="pop-up|dialog"] floating enable

# --- Layout -----------------------------------------------------------------
# aerospace 'layout tiles horizontal vertical'
bindsym $mod+slash layout toggle split
# aerospace 'layout accordion horizontal vertical' (closest i3 has: tabbed/stacked)
bindsym $mod+comma layout toggle tabbed stacking

# --- Focus / move -----------------------------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+shift+h move left
bindsym $mod+shift+j move down
bindsym $mod+shift+k move up
bindsym $mod+shift+l move right

# --- Resize (aerospace 'resize smart -/+50') --------------------------------
bindsym $mod+minus resize shrink width 50 px or 5 ppt
bindsym $mod+equal resize grow width 50 px or 5 ppt
bindsym $mod+shift+minus resize shrink height 50 px or 5 ppt
bindsym $mod+shift+equal resize grow height 50 px or 5 ppt

# --- Fullscreen -------------------------------------------------------------
bindsym $mod+Return fullscreen toggle
# aerospace 'macos-native-fullscreen' -> span all monitors
bindsym $mod+shift+Return fullscreen toggle global

# --- Workspaces -------------------------------------------------------------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6

bindsym $mod+shift+1 move container to workspace number 1
bindsym $mod+shift+2 move container to workspace number 2
bindsym $mod+shift+3 move container to workspace number 3
bindsym $mod+shift+4 move container to workspace number 4
bindsym $mod+shift+5 move container to workspace number 5
bindsym $mod+shift+6 move container to workspace number 6
bindsym $mod+shift+n move container to workspace n
bindsym $mod+shift+c move container to workspace c

# --- App launchers ----------------------------------------------------------
# Like aerospace's 'open -a': focus the app if it's running, otherwise start it.
# The assign rules above put it on its workspace either way.
bindsym $mod+shift+d exec --no-startup-id $launch discord   flatpak run com.discordapp.Discord
bindsym $mod+s       exec --no-startup-id $launch slack     flatpak run com.slack.Slack
bindsym $mod+shift+s exec --no-startup-id $launch spotify   flatpak run com.spotify.Client
bindsym $mod+t       exec --no-startup-id $launch com.mitchellh.ghostty ghostty
bindsym $mod+w       exec --no-startup-id $launch cursor    cursor
bindsym $mod+p       exec --no-startup-id $launch pycharm   pycharm
bindsym $mod+i       exec --no-startup-id $launch 'intellij|idea' intellij-idea-ultimate
#bindsym $mod+g      exec --no-startup-id $launch goland    goland
bindsym $mod+c       exec --no-startup-id $launch google-chrome google-chrome-stable
bindsym $mod+shift+f exec --no-startup-id $launch firefox   firefox
bindsym $mod+m       exec --no-startup-id $launch 'mongodb compass' mongodb-compass
bindsym $mod+shift+b exec --no-startup-id $launch bruno     bruno
bindsym $mod+z       exec --no-startup-id $launch zoom      zoom
bindsym $mod+n       exec --no-startup-id $launch xed       xed

# --- i3 basics (macOS provides these outside aerospace) ---------------------
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+shift+q kill
bindsym $mod+shift+space floating toggle
bindsym $mod+shift+r restart
bindsym $mod+shift+e exec --no-startup-id i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'
bindsym $mod+Escape exec --no-startup-id loginctl lock-session

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# --- Service mode (aerospace alt-shift-semicolon) ---------------------------
bindsym $mod+shift+semicolon mode "service"
mode "service" {
    bindsym Escape reload; mode "default"
    # aerospace 'flatten-workspace-tree' has no i3 equivalent; reset the layout instead
    bindsym r layout default; mode "default"
    bindsym f floating toggle; mode "default"
    # aerospace 'join-with': i3 instead splits the focused window, then you move into it
    bindsym shift+h split horizontal; mode "default"
    bindsym shift+l split horizontal; mode "default"
    bindsym shift+j split vertical; mode "default"
    bindsym shift+k split vertical; mode "default"
}

# --- Bar --------------------------------------------------------------------
bar {
    position top
    status_command i3status
    tray_output primary
}
