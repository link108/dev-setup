# Modifier: super is cmd, same key and name as on the Mac (alt is cortile's, like aerospace's option).

# Clipboard: super+c/v (ctrl+shift+c/v also work)
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Font size (default ctrl+minus is fine too; super+minus is taken by splits)
keybind = super+equal=increase_font_size:1
keybind = super+shift+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# Splits: super+\ right, super+- down
keybind = super+backslash=new_split:right
keybind = super+minus=new_split:down
keybind = super+shift+backslash=equalize_splits
keybind = super+w=close_surface

# Focus splits (vim keys)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right

# Resize splits
keybind = super+shift+h=resize_split:left,10
keybind = super+shift+j=resize_split:down,10
keybind = super+shift+k=resize_split:up,10
keybind = super+shift+l=resize_split:right,10

# Zoom current split to fill the window. alt+enter (window takes over the screen) is cortile's, see
# dotfiles/linux/cortile/zoom-toggle.sh; ghostty's own fullscreen fights the tiling.
keybind = super+shift+enter=toggle_split_zoom
# fullscreen is super+enter for every app (cinnamon.sh); free ctrl+enter for the shell
keybind = ctrl+enter=unbind

# Tabs and windows
keybind = super+t=new_tab
keybind = super+n=new_window
keybind = super+shift+left_bracket=previous_tab
keybind = super+shift+right_bracket=next_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=last_tab
